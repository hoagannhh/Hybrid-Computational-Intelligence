# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Test, lint and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Local credentials (keep credential-free examples shareable)
.env
.env.*
!.env.example
!.env.template
kaggle.json
access_token
.kaggle/
*.key
*.pem

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*
kaggle_outputs/
kaggle_evaluation/

# Local notebook generation helpers (keep standalone .ipynb files public)
/notebooks/_kaggle_workflow.py
/notebooks/build_notebooks.py

# IDE and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Data & Models (ignore large binary files and raw data, keep directory structures)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep

saved_models/*
!saved_models/.gitkeep

# Generated model weights and serialized arrays/scalers, including custom paths
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# Experiment logs and results
*.log
logs/*
!logs/.gitkeep
runs/
wandb/
mlruns/
reports/experiments/
reports/
reports/figures/*
!reports/figures/.gitkeep
reports/tables/*
!reports/tables/.gitkeep

# Temporary local files
tmp/
temp/
*.tmp
*.bak

# configs/experiment.local.yaml and configs/config.cpu.yaml are portable
# experiment configurations, not private machine settings; keep them shareable.
